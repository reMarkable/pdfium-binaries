@@ -95,17 +95,18 @@
 
   static constexpr char kExpectedXrefAndTrailerPrefix[] =
       "xref\r\n"
-      "0 1\r\n"
-      "0000000000 65535 f\r\n"
-      "2 1\r\n"
+      "0 8\r\n"
+      "0000000001 65535 f\r\n"
+      "0000000003 65535 f\r\n"
       "0000000017 00000 n\r\n"
-      "4 1\r\n"
+      "0000000005 65535 f\r\n"
       "0000000066 00000 n\r\n"
-      "7 1\r\n"
+      "0000000006 65535 f\r\n"
+      "0000000000 65535 f\r\n"
       "0000000122 00000 n\r\n"
-      "trailer\r\n";
+      "trailer\r\n"
+      "<</Root 2 0 R /Size 8/ID[<";
 
-  // TODO(crbug.com/42271313): xref section should not have gaps.
   EXPECT_THAT(GetString(), testing::HasSubstr(kExpectedXrefAndTrailerPrefix));
 
   // Also make sure the saved PDF still loads.
diff --git a/fpdfsdk/fpdf_save_embeddertest.cpp b/fpdfsdk/fpdf_save_embeddertest.cpp
index 58b8174..8c2d798 100644
--- a/fpdfsdk/fpdf_save_embeddertest.cpp
+++ b/fpdfsdk/fpdf_save_embeddertest.cpp
@@ -166,11 +166,12 @@
   EXPECT_THAT(GetString(), HasSubstr("/Root "));
   EXPECT_THAT(GetString(), HasSubstr("/Info "));
   EXPECT_THAT(GetString(), HasSubstr("/Size 37"));
+  EXPECT_THAT(GetString(), HasSubstr("xref\r\n0 37\r\n"));
   EXPECT_THAT(GetString(), HasSubstr("35 0 obj"));
   EXPECT_THAT(GetString(), HasSubstr("36 0 obj"));
   EXPECT_THAT(GetString(), Not(HasSubstr("37 0 obj")));
   EXPECT_THAT(GetString(), Not(HasSubstr("38 0 obj")));
-  EXPECT_EQ(7884u, GetString().size());
+  EXPECT_EQ(7912u, GetString().size());
 
   // Make sure new document renders the same as the old one.
   ScopedSavedDoc saved_document = OpenScopedSavedDocument();
